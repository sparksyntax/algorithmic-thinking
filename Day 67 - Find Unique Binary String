class Solution {
    public String findDifferentBinaryString(String[] nums) {
        int n = nums.length;
        Set set = new HashSet<>();
        
        for(String s : nums) {
            set.add(Integer.parseInt(s, 2));
        }
        
        for(int i = 0; i < (1 << n); i++) {
            if(!set.contains(i)) {
                String binary = Integer.toBinaryString(i);
                while(binary.length() < n) {
                    binary = "0" + binary;
                }
                return binary;
            }
        }
        
        return "";
    }
}
