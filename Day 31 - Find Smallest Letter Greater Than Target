class Solution {
    public char nextGreatestLetter(char[] letters, char target) {
        char result = letters[0];
        boolean flag = false;

        for (char ch : letters) {
            if (!flag && ch > target) {
                result = ch;
                flag = !flag;
            }
            else if (ch > target && ch < result) {
                result = ch;
            }
        }

        return result;
    }
}
