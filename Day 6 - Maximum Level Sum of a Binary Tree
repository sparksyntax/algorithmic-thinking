class Solution {
    public int maxLevelSum(TreeNode root) {
        int maxSum = Integer.MIN_VALUE;
        int ans = 0, level = 0;

        Queue<TreeNode> q = new LinkedList<>();
        q.offer(root);

        while (!q.isEmpty()) {
            level++;
            int currentSum = 0;

            for (int i = q.size(); i > 0; --i) {
                TreeNode node = q.poll();
                currentSum += node.val;

                if (node.left != null) {
                    q.offer(node.left);
                }
                if (node.right != null) {
                    q.offer(node.right);
                }
            }

            if (maxSum < currentSum) {
                maxSum = currentSum;
                ans = level;
            }
        }

        return ans;
    }
}
