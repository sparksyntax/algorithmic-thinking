class Solution {
    public int countPrimeSetBits(int left, int right) {
        int result = 0;

        for (int x = left; x <= right; x++) {
            if (isSmallPrime(Integer.bitCount(x))) {
                result++;
            }
        }

        return result;
    }

    private boolean isSmallPrime(int x) {
        return (x == 2 || x == 3 || x == 5 || x == 7
        || x == 11 || x == 13 || x == 17 || x == 19);
    }
}
