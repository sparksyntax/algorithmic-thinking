class Solution {
    public int largestMagicSquare(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        int side = Math.min(m, n);

        while (side > 0) {
            for (int i = 0; i < m; i++) {
                for (int j = 0; j < n; j++) {
                    if (i + side <= m && j + side <= n) {
                        if (isValid(grid, i, j, side)) {
                            return side;
                        }
                    }
                }
            }
            side--;
        }

        return 0;
    }

    private boolean isValid(int[][] grid, int i, int j, int side) {
        int sum = 0;

        for (int x = i; x < i + side; x++) {
            int rowSum = 0;
            for (int y = j; y < j + side; y++) {
                rowSum += grid[x][y];
            }
            if (x == i) {
                sum = rowSum;
            } else if (sum != rowSum) {
                return false;
            }
        }

        for (int y = j; y < j + side; y++) {
            int colSum = 0;
            for (int x = i; x < i + side; x++) {
                colSum += grid[x][y];
            }
            if (sum != colSum) {
                return false;
            }
        }

        int diagSum = 0;
        for (int k = 0; k < side; k++) {
            diagSum += grid[i + k][j + k];
        }
        if (sum != diagSum) {
            return false;
        }

        diagSum = 0;
        for (int k = 0; k < side; k++) {
            diagSum += grid[i + k][j + side - 1 - k];
        }
        if (sum != diagSum) {
            return false;
        }

        return true;
    }
}
