class Solution {
    public int countBinarySubstrings(String s) {
        int result = 0, previous = 0, streak = 1;

        for (int i = 1; i < s.length(); i++) {
            if (s.charAt(i) == s.charAt(i - 1)) {
                streak++;
            }
            else {
                previous = streak;
                streak = 1;
            }
            if (streak <= previous) {
                result++;
            }
        }

        return result;
    }
}
